<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rbtheron_plus">
    <xacro:arg name="prefix" default="robot_" />
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rbtheron_plus urdf file -->
    <xacro:include filename="$(find robotnik_description)/robots/rbtheron/rbtheron_plus.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="rbtheron_plus.ros2_control.xacro" />

    <xacro:rbtheron_plus_ros2_control
        name="FakeSystem"
        prefix="$(arg prefix)"
        initial_positions_file="$(arg initial_positions_file)"/>

</robot>
