<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotnik_simulation_navigation</name>
  <version>1.0.0</version>
  <description>Package to simulation navigation</description>
  <maintainer email="ros-developers@robotnik.es">Robotnik Developers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_panel</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>robotnik_simulation_robots</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
