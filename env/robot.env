# Loaded only by docker/runtime-entrypoint.sh.
# Empty values omit the corresponding launch argument and use its launch default.
ROBOT_ID=robot
ROBOT=rbwatcher
ROBOT_MODEL=rbwatcher
ROBOT_XACRO_PATH=
FRAME_PREFIX=
ARM_TYPE=ur10e

RUN_WORLD=true
RUN_GAZEBO_GUI=true
USE_NVIDIA_GPU=false
RUN_LOCALIZATION=true
RUN_NAVIGATION=true
RUN_MOVEIT=false
RUN_SPAWN_RVIZ=true
USE_SIM_TIME=true
LOW_PERFORMANCE_SIMULATION=true
RUN_MAPPING=false

SPAWN_RVIZ_CONFIG=
WORLD=demo
WORLD_PATH=
X=
Y=
Z=

# WORLD_PATH overrides WORLD. The Xacro path overrides only the description;
# family and variant still select control, bridge and manipulation profiles.
# Families: rb1, rbcar, rbfiqus, rbkairos, rbrobout, rbsummit, rbsummit_steel,
# rbtheron, rbvogui, rbvogui_xl, rbwatcher.
# Manipulation variants: rbkairos_plus, rbrobout_plus, rbtheron_plus, rbvogui_plus.
# frame_prefix defaults to <ROBOT_ID>_ and applies to frames and joints.
# Built-in worlds: demo, empty, ionic, lightweight_scene.
# RUN_WORLD=false starts only this robot and its selected modules in an existing
# Gazebo world. Start the world and its /clock bridge once per shared simulation.
# World path, GUI and GPU settings apply only when RUN_WORLD=true.
# USE_NVIDIA_GPU=true requests NVIDIA PRIME offload for Gazebo server and GUI
# using __NV_PRIME_RENDER_OFFLOAD=1 and __GLX_VENDOR_LIBRARY_NAME=nvidia.
# False preserves normal GPU selection, including any inherited environment.
# In Docker, NVIDIA devices/drivers must also be exposed by the GPU compose file.
#
# Localization and navigation are independent; missing profiles are skipped
# with a warning. No odometry-only navigation fallback is provided.
# The basic RViz opens unless navigation starts. Navigation and MoveIt own
# their RViz options and enable their views by default; bringup does not set them.
# For base simulation without windows, disable the GUI, basic RViz, navigation
# and MoveIt. Configure module-specific views through their standalone launches.
# SPAWN_RVIZ_CONFIG accepts a file path; empty selects its package default.
# MoveIt's generic RViz selects the unique planning group from the expanded SRDF.
#
# Example: Kairos with navigation and manipulation:
# ROBOT=rbkairos
# ROBOT_MODEL=rbkairos_plus
# RUN_MOVEIT=true
#
# ROBOTNIK_LAUNCH_ARGS, when nonempty, replaces automatic argument translation.
# Outside Docker, pass arguments explicitly to ros2 launch; launch files do not
# read these environment variables.
